{
  "name": "pcf-harness",
  "version": "1.0.0",
  "description": "PCF Workbench — a full-featured development environment for Power Apps Component Framework controls",
  "type": "module",
  "bin": {
    "pcf-harness": "./bin/pcf-harness.js"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jaduplesms/PCF-Workbench.git"
  },
  "homepage": "https://github.com/jaduplesms/PCF-Workbench#readme",
  "bugs": {
    "url": "https://github.com/jaduplesms/PCF-Workbench/issues"
  },
  "keywords": [
    "pcf",
    "power-apps",
    "power-platform",
    "component-framework",
    "dataverse",
    "dynamics-365",
    "dev-tools",
    "testing",
    "harness",
    "vite"
  ],
  "files": [
    "bin/",
    "src/",
    "public/",
    "index.html",
    "vite.config.ts",
    "tsconfig.json",
    "tsconfig.node.json"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run build",
    "harness": "tsx bin/pcf-harness.ts",
    "conformance:diff": "tsx scripts/conformance-diff.ts"
  },
  "dependencies": {
    "@azure/msal-node": "^5.2.2",
    "@azure/msal-node-extensions": "^5.2.2",
    "@fluentui/react-components": "^9.73.8",
    "@fluentui/react-icons": "^2.0.327",
    "chokidar": "^3.6.0",
    "commander": "^12.1.0",
    "fast-xml-parser": "^5.7.0",
    "html2canvas": "^1.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.21.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@fluentui/font-icons-mdl2": "^8.5.73",
    "@playwright/test": "^1.59.1",
    "@types/node": "^22.0.0",
    "@types/powerapps-component-framework": "^1.3.18",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/xrm": "^9.0.92",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.0",
    "vite": "^6.4.2"
  }
}
